      "microservice": {
        "title": "Microservice Framework",
        "description": "Cara ringan dan siap cloud untuk membangun aplikasi enterprise dengan memecahnya menjadi layanan-layanan kecil yang mandiri, mudah diskalakan, berjalan andal, dan memungkinkan Anda menghadirkan fitur baru lebih cepat."
      },
      "reactive": {
        "title": "Reactive-MVC Programming",
        "description": "Merespons data dan peristiwa secara instan, sehingga sistem menjadi lebih cepat, lebih efisien, dan mampu menangani banyak pengguna secara bersamaan tanpa mengalami penurunan kinerja dibandingkan dengan framework MVC tradisional."
      },
      "spring": {
        "title": "Spring Framework",
        "description": "Framework enterprise yang telah terbukti, membantu organisasi mempercepat transformasi digital dengan mengurangi waktu pengembangan, menekan biaya operasional, dan memastikan skalabilitas sistem."
      },
      "agnostic": {
        "title": "Agnostic Oriented",
        "description": "Bersifat agnostik terhadap model bisnis apa pun, sehingga framework ini dapat digunakan untuk membangun aplikasi dengan berbagai jenis model bisnis."
      }
